# The drive sidecar: rclone + FUSE, supervised by silo-drive. Keep the rclone
# version in step with internal/drives/testdata/rclone_options.json.
FROM docker.io/rclone/rclone:1.75.1 AS rclone

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    fuse3 ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && echo user_allow_other >> /etc/fuse.conf
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
COPY bin/silo-drive /usr/local/bin/silo-drive
RUN chmod +x /usr/local/bin/silo-drive && mkdir -p /mnt/drives /cache /run/silo-drive
ENTRYPOINT ["/usr/local/bin/silo-drive"]
