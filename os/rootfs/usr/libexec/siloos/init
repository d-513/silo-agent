#!/bin/bash
# siloos-init: what SiloOS makes once, on the machine it boots, and never
# overwrites. Runs as root before silo's user manager (siloos-init.service).
#
#   /etc/silo/silo.env       the operator's settings, from the template
#   /etc/silo/postgres.env   the database's password
#   /etc/silo/secrets.env    the control plane's database URL and first admin
#   /etc/issue.d/50-silo.issue  where to sign in, and the first admin, on the console
set -euo pipefail
umask 077

dir=/etc/silo
install -d -m 0750 -o root -g silo "$dir"

# put FILE writes stdin to FILE (root:silo 0640) unless it is already there.
put() {
	local file=$1
	if [ -s "$file" ]; then
		cat >/dev/null
		return
	fi
	cat >"$file.tmp"
	chown root:silo "$file.tmp"
	chmod 0640 "$file.tmp"
	mv "$file.tmp" "$file"
}

random() { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }

# readable is a password a person types once from a screen: 12 characters of
# an alphabet with no look-alikes (no 0, 1, l, o), in threes of four
# (k7mp-x3qa-9ten): 60 bits, against a sign-in that throttles guessing. 32
# letters, so a byte modulo 32 is unbiased.
readable() {
	local abc=abcdefghijkmnpqrstuvwxyz23456789 out="" b
	for b in $(od -An -tu1 -N12 /dev/urandom); do
		out+=${abc:$((b % 32)):1}
	done
	printf '%s-%s-%s' "${out:0:4}" "${out:4:4}" "${out:8:4}"
}

put "$dir/silo.env" </usr/share/siloos/silo.env

# The first admin is the operator's when they named one before the first
# boot (cloud-init's user-data, or by hand): in silo.env, or in Silo's own
# silo.yaml. Then nothing is generated, since an environment variable here
# would win over their silo.yaml.
own_admin=no
if grep -q '^SILO_BOOTSTRAP__EMAIL=.' "$dir/silo.env" 2>/dev/null ||
	grep -q '^bootstrap:' /var/lib/silo/silo.yaml 2>/dev/null; then
	own_admin=yes
fi

if [ ! -s "$dir/postgres.env" ] || [ ! -s "$dir/secrets.env" ]; then
	# Both or neither: the URL carries the password.
	rm -f "$dir/postgres.env" "$dir/secrets.env"
	db=$(random 24)
	put "$dir/postgres.env" <<-END
		POSTGRES_PASSWORD=$db
	END
	{
		echo "SILO_DATABASE_URL=postgres://silo:$db@127.0.0.1:5432/silo?sslmode=disable"
		if [ "$own_admin" = no ]; then
			# The first admin, made at the control plane's first start. Once an
			# admin exists these do nothing (docs/CONFIGURATION.md § Sign-in).
			echo "SILO_BOOTSTRAP__EMAIL=admin@silo.local"
			echo "SILO_BOOTSTRAP__PASSWORD=$(readable)"
		fi
	} | put "$dir/secrets.env"
fi

# The console says where Silo is and, until an admin of the operator's own
# was named, the generated first admin: the media carry no login, so whoever
# is at the console (or a VM's) is the one who sets the machine up. It is
# only the first password: changing it on the Account page makes this line
# stale, and once an admin exists bootstrap does nothing.
install -d -m 0755 /etc/issue.d
email=$(sed -n 's/^SILO_BOOTSTRAP__EMAIL=//p' "$dir/secrets.env" 2>/dev/null)
pass=$(sed -n 's/^SILO_BOOTSTRAP__PASSWORD=//p' "$dir/secrets.env" 2>/dev/null)
if [ -n "$pass" ] && [ -e /var/lib/silo/data/first-admin-signed-in ]; then
	# Silo writes the marker at the first admin's first sign-in
	# (account.FirstAdminMarker): from the next boot the password is not shown.
	who="Sign in as your admin. (The first password: sudo cat /etc/silo/secrets.env)"
elif [ -n "$pass" ]; then
	who="First sign-in: $email / $pass  (change the password once in)"
else
	who="Sign in as the first admin your user-data or silo.yaml named."
fi
cat >/etc/issue.d/50-silo.issue <<END

  SiloOS  ·  https://\\4
  $who
  The certificate is Silo's own until a domain is set, so the browser warns once
  (Admin → SiloOS has the root certificate to install on your devices).

END
