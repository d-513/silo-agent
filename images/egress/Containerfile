# The network filter gateway: one per container engine. It serves DNS, the HTTP
# proxy, transparent 80/443 and SOCKS5 for every Bot box and STDIO sidecar, and
# dials the control plane. It needs nothing but its binary and root CA certs
# (for the threat-list downloads).
FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY build/bin/silo-egress /usr/local/bin/silo-egress
RUN chmod +x /usr/local/bin/silo-egress
ENTRYPOINT ["/usr/local/bin/silo-egress"]

# Last, so a new commit does not rebuild anything above.
ARG REVISION=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.title="silo-egress" \
      org.opencontainers.image.description="The Silo network filter gateway" \
      org.opencontainers.image.source="https://github.com/d-513/silo-agent" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim"
