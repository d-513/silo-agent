# The drive sidecar: rclone + FUSE, supervised by silo-drive. Keep the rclone
# version in step with internal/drives/testdata/rclone_options.json.
FROM docker.io/rclone/rclone:1.76.0@sha256:7cbeec24a44f206067597c0368be4de90ae19a64d5113c7d1938bd737a81e466 AS rclone

FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
RUN apt-get update && apt-get install -y --no-install-recommends \
    fuse3 ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && echo user_allow_other >> /etc/fuse.conf
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
COPY build/bin/silo-drive /usr/local/bin/silo-drive
RUN chmod +x /usr/local/bin/silo-drive && mkdir -p /mnt/drives /cache /run/silo-drive
ENTRYPOINT ["/usr/local/bin/silo-drive"]

# Last, so a new commit does not rebuild anything above.
ARG REVISION=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.title="silo-drive" \
      org.opencontainers.image.description="A Silo drive sidecar: rclone mounts over FUSE, supervised by silo-drive" \
      org.opencontainers.image.source="https://github.com/d-513/silo-agent" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim"
