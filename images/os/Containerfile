# syntax=docker/dockerfile:1
#
# SiloOS: a bootable image (bootc) whose only job is to run Silo. The host is
# Fedora's bootc base; everything Silo is runs in containers under one
# unprivileged user, `silo` (uid 1000), on its rootless Podman:
#
#   silodb     Postgres + pgvector (silodb.container)
#   silo       the control plane, console inside (silo.container), which makes
#              every Bot's box and sidecar through that user's Podman socket
#   silocaddy  silo-caddy (images/caddy/): HTTPS, configured by the control
#              plane through its admin socket (silocaddy.container,
#              internal/caddy)
#
# and on the host, as root, siloosd (cmd/siloosd): the one way the control
# plane changes the machine (network, host name, time, updates, power), on a
# socket only the control plane's container has.
#
# The OS is the release: SILO_IMAGE names the control plane it runs, and the
# control plane names the bot, STDIO, drive and egress images of its own
# commit, so one OS image is one matched set. Updating Silo is `bootc upgrade`.
#
# One image for every install: an installer ISO or a disk for a machine you
# set up yourself, and a cloud image configured at first boot by cloud-init
# (which turns itself off where no cloud answers). Which channel a machine
# follows is the image name it was installed from (images/os/README.md § Channels).
#
# Build with `make os-image`: the context is os/ and build/bin/siloosd only
# (images/os/Containerfile.dockerignore). See images/os/README.md.
# The base follows Fedora 45's bootc tag, not a digest, unlike every other
# base in this repository: Fedora rebuilds it about daily with the
# distribution's fixes, which a SiloOS build should carry, and quay.io
# deletes the builds it replaced within days, so a pinned digest stops
# resolving (CI failed on exactly that). The digest a build used is in its
# build log, and Fedora 46 is a change of this line.
FROM quay.io/fedora/fedora-bootc:45

# cloud-init, for cloud images and VMs that hand a user, a key and settings
# at first boot. On a machine with no cloud metadata ds-identify turns it off
# (etc/cloud/cloud.cfg.d/05_siloos.cfg lists no "None" datasource).
#
# And every hypervisor's guest agent, since SiloOS often runs as a VM: each
# starts only on its own hypervisor, so a bare-metal install runs none.
#   qemu-guest-agent  Proxmox, libvirt, OpenStack (udev, on its virtio port)
#   open-vm-tools     VMware (ConditionVirtualization=vmware)
#   hyperv-daemons    Hyper-V, Azure (ConditionVirtualization=microsoft)
#   incus-agent       Incus: `incus exec`, and the guest API cloud-init reads
#                     (the binary; incus-agent.service starts it, udev on
#                     Incus's port)
# Weak dependencies stay out: with them open-vm-tools and friends bring a
# hundred desktop libraries (X11, Wayland) a server has no use for.
RUN dnf -y install --setopt=install_weak_deps=False cloud-init qemu-guest-agent open-vm-tools hyperv-daemons incus-agent \
    && dnf clean all \
    && ln -s ../cloud-init.target /usr/lib/systemd/system/default.target.wants/cloud-init.target \
    && rm -rf /var/cache/* /var/log/* /var/lib/dnf /var/lib/cloud /var/lib/hyperv /run/cloud-init /run/dnf

COPY images/os/rootfs/ /

# The user every Silo container runs under. Made now, not only by sysusers at
# first boot, so a user made at install (cloud-init, a kickstart)
# never takes uid 1000. Its subordinate ids are what its containers' users map
# to; the range is Fedora's first default one.
RUN set -e; \
    systemd-sysusers; \
    for f in /etc/subuid /etc/subgid; do \
      grep -q '^silo:' "$f" 2>/dev/null || echo 'silo:524288:65536' >> "$f"; \
    done

# Bot boxes bind folders of data/ unlabelled (internal/dockerx), so those
# folders carry the label every container may use; what the control plane
# makes under them inherits it.
RUN semodule -i /usr/share/siloos/selinux/siloos.cil

# siloosd keeps the update policy in place of bootc's own timer, masked here,
# which reboots whenever it finds a new image: an admin chooses that in
# Admin → SiloOS.
RUN chmod 0755 /usr/libexec/siloos/init \
    && systemctl enable siloos-init.service siloosd.service vmtoolsd.service \
    && systemctl mask bootc-fetch-apply-updates.timer

# What this image is. REGISTRY and VERSION are the release's (`make
# release`/`nightly`, .github/workflows/images.yml): the OS runs the control
# plane and the Caddy of the same tag, and its channels are tags of
# <registry>/silo-os. A dev build (no registry) runs the nightly's and may be
# moved to a channel of the published repository. SILO_IMAGE, CADDY_IMAGE and
# OS_REPOSITORY override one each.
ARG REGISTRY=
ARG VERSION=dev
ARG REVISION=unknown
ARG SILO_IMAGE=
ARG CADDY_IMAGE=
ARG OS_REPOSITORY=
RUN set -e; \
    reg="${REGISTRY:-ghcr.io/d-513}"; \
    tag="$VERSION"; [ "$tag" = dev ] && tag=master; \
    silo="${SILO_IMAGE:-$reg/silo:$tag}"; \
    caddy="${CADDY_IMAGE:-$reg/silo-caddy:$tag}"; \
    repo="${OS_REPOSITORY:-$reg/silo-os}"; \
    sed -i "s|@SILO_IMAGE@|$silo|" /etc/containers/systemd/users/1000/silo.container; \
    sed -i "s|@CADDY_IMAGE@|$caddy|" /etc/containers/systemd/users/1000/silocaddy.container; \
    install -d /usr/lib/siloos; \
    printf 'SILOOS_VERSION=%s\nSILOOS_REVISION=%s\nSILOOS_REPOSITORY=%s\nSILOOS_SILO_IMAGE=%s\nSILOOS_CADDY_IMAGE=%s\n' \
      "$VERSION" "$REVISION" "$repo" "$silo" "$caddy" > /usr/lib/siloos/release; \
    cat /usr/lib/siloos/release

# The host daemon changes with every commit: late, so it rebuilds little.
COPY --chmod=0755 build/bin/siloosd /usr/bin/siloosd

# siloosd asks the registry about channels with skopeo (bootc's own image
# proxy needs it, so it is in the base).
RUN test -x /usr/bin/skopeo && bootc container lint

LABEL org.opencontainers.image.title="silo-os" \
      org.opencontainers.image.description="SiloOS: a bootable image that runs Silo" \
      org.opencontainers.image.source="https://github.com/d-513/silo-agent" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.base.name="quay.io/fedora/fedora-bootc:45" \
      containers.bootc="1" \
      ostree.bootable="1"
