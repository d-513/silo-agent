# SiloOS: the operator's settings for the control plane, as SILO_* variables
# (docs/CONFIGURATION.md lists them all). Copied to /etc/silo/silo.env on the
# first boot and never touched again. After a change:
#
#   sudo systemctl --user -M silo@ restart silo
#
# Anything set here wins over Admin → Settings, which then shows the field
# locked; leave a setting out to manage it from the console instead.

# HTTPS needs nothing here. The machine's own name and addresses are HTTPS
# from the first boot, with Silo's own certificate authority. For a domain,
# set Public URL (Server) and the certificates (HTTPS: Let's Encrypt over port
# 80, or through a DNS provider such as Cloudflare) in Admin → Settings.

# The first admin, in place of the generated one in secrets.env. Only read
# while no admin exists.
#SILO_BOOTSTRAP__EMAIL=you@example.com
#SILO_BOOTSTRAP__PASSWORD=change-me-at-once

# Mail to the Bots' addresses (the listener is on port 25 already).
#SILO_MAIL__DOMAIN=bots.example.com
