# A Bot's machine. Every base and download is pinned (by digest, version or
# checksum), so two builds from one commit get the same image; move a pin on
# purpose. Layers run from what changes least to what changes most: the
# worker binary is the last thing copied.

# Node.js comes from the official image (same Debian, right architecture)
# rather than Debian's older nodejs package.
FROM docker.io/library/node:26-trixie-slim@sha256:abe7e5a82b61a8ef67b315b85497c9e65173387ccf2f4a029248184b8e020be5 AS node

# Lightpanda is the headless browser the page reader renders script-built pages
# with (cmd/silo-worker/render.go). Pinned to a release by tag and digest: move
# both on purpose and re-run the render checks.
FROM docker.io/lightpanda/browser:1.0.5@sha256:c474699588315f2d5ba1574a0608feeaf29a31663b845b640d2dd87dd2781ce0 AS lightpanda

# uv and uvx: Python packages and one-off tools without touching the system's.
FROM ghcr.io/astral-sh/uv:0.13.10@sha256:a3ea1357342c1a4bf9a0c53a3deb1b55379aefa037338d8113d5771efa01774f AS uv

FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 \
    PATH=/home/silo/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The machine: tini as PID 1, the desktop, Chromium, fonts, Python, the user.
# certutil (libnss3-tools), proxychains4, netcat and ssh are what start.sh
# points at the network filter (its CA for Chromium, its SOCKS5 door).
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini sudo ca-certificates \
    xvfb openbox tint2 thunar feh xfce4-terminal mousepad x11vnc chromium \
    scrot xdotool xclip wmctrl x11-xserver-utils dbus-x11 \
    adwaita-icon-theme gnome-themes-extra \
    fonts-liberation fonts-liberation2 fonts-dejavu fonts-noto-core fonts-noto-color-emoji \
    fonts-freefont-ttf fonts-inter fonts-ebgaramond fonts-linuxlibertine \
    python3 python3-pip python3-venv python3-dev python-is-python3 pipx \
    libnss3-tools proxychains4 netcat-openbsd openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /bin/bash --user-group silo \
    && echo 'silo ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/silo \
    && chmod 440 /etc/sudoers.d/silo

# Documents, OCR and media: what Knowledge, the page reader and the document
# skills run, and what a Bot reaches for with a file someone sent. tesseract
# reads every installed language pack, English first.
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils ghostscript qpdf pandoc img2pdf weasyprint ocrmypdf \
    tesseract-ocr tesseract-ocr-pol catdoc antiword unrtf \
    imagemagick librsvg2-bin graphviz libimage-exiftool-perl ffmpeg sox \
    && rm -rf /var/lib/apt/lists/*

# Python libraries from Debian, so they match the system Python.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-requests python3-httpx python3-bs4 python3-lxml python3-yaml \
    python3-numpy python3-pandas python3-scipy python3-matplotlib python3-seaborn \
    python3-pil python3-reportlab python3-pypdf python3-docx python3-openpyxl \
    python3-xlrd python3-xlsxwriter python3-odf python3-jinja2 python3-markdown \
    python3-tabulate python3-tqdm python3-rich python3-dateutil python3-networkx \
    python3-feedparser python3-icalendar python3-qrcode python3-cryptography \
    python3-greenlet python3-typing-extensions \
    && rm -rf /var/lib/apt/lists/*

# The shell's everyday tools, archives, and a compiler for native packages
# (node-gyp, pip source builds). git is also the workspace history's store.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget jq yq sqlite3 file less nano vim-tiny tree lsof psmisc procps \
    rsync patch bc gettext-base git ripgrep fd-find \
    zip unzip xz-utils bzip2 zstd 7zip \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

# What Debian does not package, pinned. Playwright drives the desktop's own
# Chromium over CDP, so it never downloads a browser.
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pip3 install --break-system-packages --no-cache-dir \
    playwright==1.65.2 python-pptx==1.0.2 pdfplumber==0.11.11 duckdb==2.0.1 \
    "yt-dlp[default]==2026.11.23"
# yt-dlp solves YouTube's player challenges with a JavaScript runtime: the
# image has Node, not the Deno it looks for by default.
RUN printf -- '--js-runtimes node\n' > /etc/yt-dlp.conf
# pip may install for the silo user: it then falls back to ~/.local by itself
# (the system's site-packages are root's), and that folder exists from the
# start so an interpreter that is already running sees what lands there.
RUN printf '[global]\nbreak-system-packages = true\n' > /etc/pip.conf \
    && site=$(HOME=/home/silo python3 -c 'import site; print(site.getusersitepackages())') \
    && mkdir -p "$site" /home/silo/.local/bin \
    && chown -R silo:silo /home/silo/.local

COPY --from=uv /uv /uvx /usr/local/bin/

# Lightpanda (AGPL-3.0), unmodified and run as a program of its own; the notice
# says where its source is. Telemetry is off for the worker's renders and for a
# Bot that runs it by hand.
COPY --from=lightpanda /bin/lightpanda /usr/local/bin/lightpanda
RUN mkdir -p /usr/share/doc/lightpanda \
    && printf '%s\n' 'Lightpanda browser, unmodified release build from docker.io/lightpanda/browser.' \
       'Copyright Lightpanda (Selecy SAS). Licensed under the GNU Affero General Public License v3.0.' \
       'Source code: https://github.com/lightpanda-io/browser (the version is printed by `lightpanda version`).' \
       > /usr/share/doc/lightpanda/NOTICE
ENV LIGHTPANDA_DISABLE_TELEMETRY=true

# Node.js + npm + pnpm for web projects and JS tooling.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install -g --no-fund --no-audit pnpm@12.23.0 \
    && npm cache clean --force \
    && rm -rf /root/.npm

# uBlock Origin Lite, unpacked for --load-extension. Chromium writes its
# rule indexes into the extension's folder, so the silo user owns it.
ADD --checksum=sha256:b0472c07028ced638cc0ae7c57403dd95ad6cdfc7391a37f9fa7aaf6239dfc55 \
    https://github.com/uBlockOrigin/uBOL-home/releases/download/2026.1124.1811/uBOLite_2026.1124.1811.chromium.zip /tmp/ubol.zip
RUN mkdir -p /tmp/ubol-src /opt/silo/ubol \
    && unzip -q /tmp/ubol.zip -d /tmp/ubol-src \
    && m=$(find /tmp/ubol-src -name manifest.json | head -1) \
    && test -n "$m" \
    && cp -a "$(dirname "$m")/." /opt/silo/ubol/ \
    && rm -rf /tmp/ubol.zip /tmp/ubol-src \
    && test -f /opt/silo/ubol/manifest.json \
    && chown -R silo:silo /opt/silo/ubol

# Every tool the prompt and the skills promise is here, or the build fails.
# The dock's launchers name the apps' own icons (Adwaita no longer draws the
# old app icons), so each of those is checked here too.
RUN for i in org.xfce.thunar org.xfce.terminal org.xfce.mousepad; do \
      ls /usr/share/icons/hicolor/*/apps/"$i".* >/dev/null 2>&1 || { echo "missing icon: $i" >&2; exit 1; }; \
    done \
    && for c in tini sudo chromium xclip wmctrl python3 pip pipx uv uvx node npm npx pnpm \
        lightpanda pdftotext pdftoppm qpdf pandoc ocrmypdf tesseract catdoc antiword \
        convert rsvg-convert dot exiftool ffmpeg ffprobe sox curl wget jq yq sqlite3 \
        file less nano tree lsof rsync git rg fd zip unzip xz bzip2 zstd 7z make gcc \
        certutil proxychains4 nc ssh yt-dlp; do \
      command -v "$c" >/dev/null || { echo "missing: $c" >&2; exit 1; }; \
    done \
    && python3 -c 'import playwright, pptx, pdfplumber, duckdb, httpx, scipy, docx, openpyxl, weasyprint' \
    && yt-dlp --version >/dev/null

# Silo's own files, last: they change most.
COPY images/bot/openbox/autostart /opt/silo/openbox/autostart
COPY images/bot/openbox/rc.xml /opt/silo/openbox/rc.xml
COPY images/bot/tint2/tint2rc /opt/silo/tint2/tint2rc
COPY images/bot/apps/ /opt/silo/desktop/
COPY images/bot/wallpaper.png /opt/silo/wallpaper.png
COPY images/bot/gtk-3.0/ /opt/silo/gtk-3.0/
COPY images/bot/thunar/thunarrc /opt/silo/thunar/thunarrc
COPY images/bot/mimeapps.list /opt/silo/mimeapps.list
COPY images/bot/chromium.png /opt/silo/chromium.png
COPY images/bot/chromium/policies.json /etc/chromium/policies/managed/silo.json
COPY images/bot/chromium/egress.pac /opt/silo/egress.pac
COPY --chown=silo:silo images/bot/chromium/stealth/ /opt/silo/stealth/
COPY --chmod=755 images/bot/silo-chromium /usr/local/bin/silo-chromium
COPY --chmod=755 images/bot/start.sh /usr/local/bin/start.sh
COPY images/bot/silo_runtime.py /opt/silo/silo_runtime.py
RUN mkdir -p /workspace/bot /workspace/tmp /var/run/silo /run/user/1000 \
        /home/silo/chrome-profile /usr/local/share/applications /opt/silo/tools /var/lib/silo/history \
    && touch /opt/silo/tools/__init__.py \
    && cp /opt/silo/desktop/*.desktop /usr/local/share/applications/ \
    && chown silo:silo /home/silo /home/silo/chrome-profile /workspace /workspace/bot /workspace/tmp \
        /var/run/silo /run/user/1000 /opt/silo/tools /opt/silo/tools/__init__.py /var/lib/silo/history
COPY --chmod=755 build/bin/silo-worker /usr/local/bin/silo-worker

ENV DISPLAY=:1 \
    HOME=/home/silo \
    SILO_WORKSPACE=/workspace \
    SILO_WORKER_SOCK=/var/run/silo/worker.sock \
    PYTHONPATH=/opt/silo \
    USER=silo \
    LOGNAME=silo \
    XDG_RUNTIME_DIR=/run/user/1000 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
WORKDIR /workspace
# start.sh stays root to chown the mounts and supervise; tini reaps whatever
# is orphaned in the box and hands start.sh the engine's signals.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/start.sh"]

# Last, so a new commit does not rebuild anything above.
ARG REVISION=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.title="silo-bot" \
      org.opencontainers.image.description="A Silo Bot's machine: desktop, Chromium, Python, Node.js and the worker" \
      org.opencontainers.image.source="https://github.com/d-513/silo-agent" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.base.name="docker.io/library/debian:trixie-slim"
