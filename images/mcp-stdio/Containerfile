# Bases are pinned by digest: move them on purpose.
# uv and uvx, for the MCP servers published as Python packages (the Bot image's pin).
FROM ghcr.io/astral-sh/uv:0.13.10@sha256:a3ea1357342c1a4bf9a0c53a3deb1b55379aefa037338d8113d5771efa01774f AS uv

FROM docker.io/library/node:26-trixie-slim@sha256:abe7e5a82b61a8ef67b315b85497c9e65173387ccf2f4a029248184b8e020be5
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
COPY build/bin/silo-mcp-bridge /usr/local/bin/silo-mcp-bridge
RUN chmod +x /usr/local/bin/silo-mcp-bridge && uvx --version
# uv keeps what it downloads beside npm's, in the directory a Bot's sidecars
# share (dockerx.stdioCacheDir), so a recreated sidecar does not fetch it again.
ENV npm_config_update_notifier=false \
    NPM_CONFIG_FUND=false \
    UV_CACHE_DIR=/root/.npm/_uv \
    UV_NO_PROGRESS=1
ENTRYPOINT ["/usr/local/bin/silo-mcp-bridge"]

# Last, so a new commit does not rebuild anything above.
ARG REVISION=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.title="silo-mcp-stdio" \
      org.opencontainers.image.description="A Silo STDIO MCP sidecar: Node.js, Python with uv, and the bridge" \
      org.opencontainers.image.source="https://github.com/d-513/silo-agent" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.base.name="docker.io/library/node:26-trixie-slim"
