# Bases are pinned by digest: move them on purpose.
FROM docker.io/library/node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY build/bin/silo-mcp-bridge /usr/local/bin/silo-mcp-bridge
RUN chmod +x /usr/local/bin/silo-mcp-bridge
ENV npm_config_update_notifier=false \
    NPM_CONFIG_FUND=false
ENTRYPOINT ["/usr/local/bin/silo-mcp-bridge"]

# Last, so a new commit does not rebuild anything above.
ARG REVISION=unknown
ARG VERSION=dev
LABEL org.opencontainers.image.title="silo-mcp-stdio" \
      org.opencontainers.image.description="A Silo STDIO MCP sidecar: Node.js, Python and the bridge" \
      org.opencontainers.image.source="https://github.com/d-513/silo-agent" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.base.name="docker.io/library/node:24-trixie-slim"
