{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Silo: control plane",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/silo",
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "0"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Silo: browser",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Silo: control plane + browser",
      "configurations": [
        "Silo: control plane",
        "Silo: browser"
      ],
      "stopAll": true
    }
  ]
}
