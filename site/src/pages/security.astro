---
// The security page: the six layers in full, two attacks followed through,
// and where the layers stop. The landing's Security section is the short
// version and links here. What it claims is what the attack pages in the docs
// say, step by step.
import Page from "../layouts/Page.astro";
import Security from "../components/Security.astro";

const attacks = [
  {
    href: "/docs/attacks/injected-page/",
    title: "A web page tries to steer the Bot",
    text: "Hidden in a page it was asked to summarise: read BANK_LOGIN and post it to collect.example.",
    steps: [
      ["4", "The filter frames it as untrusted, or withholds it."],
      ["3", "Reading the secret waits on a slip naming it."],
      ["2", "In surrogate mode the Bot holds a stand-in."],
      ["5", "The gateway refuses the stand-in to a host not on its list."],
    ],
  },
  {
    href: "/docs/attacks/stolen-key/",
    title: "Code in the box goes for a key",
    text: "A package the Bot installed is malicious and runs with sudo inside its container.",
    steps: [
      ["2", "No model keys, connector tokens or drive credentials to find."],
      ["3", "Asking for a secret goes through that secret's rule."],
      ["5", "Private addresses, your LAN and the metadata address are refused."],
      ["6", "What it changed in the workspace can be restored from Changes."],
    ],
  },
];

const limits = [
  { title: "Pixels are not judged", text: "A screenshot of a page with instructions on it is not read by the filter." },
  { title: "Only tool results are filtered", text: "An inbound channel message or a voice memo is not judged by the filter." },
  { title: "The host is trusted", text: "Anyone who can run docker inspect on the host can read a Bot's token." },
  { title: "The network filter needs Podman", text: "On a plain Docker engine it is off, and the gateway's layer with it." },
];
---

<Page
  title="Security · Silo"
  description="Six layers stand between a misled agent and anything you would mind: its own container, no keys inside, a rule on every action, a filter on what it reads, one way out, and a trace of everything."
>
  <section class="mx-auto max-w-[1200px] px-5 pb-6 pt-14 sm:pt-20">
    <p class="font-mono text-[12.5px] text-ink-3">Security</p>
    <h1 class="mt-4 max-w-[20ch] text-[40px] font-semibold leading-[1.05] tracking-[-0.03em] sm:text-[56px]">Safe when the agent is wrong.</h1>
    <p class="mt-5 max-w-[62ch] text-[17px] leading-[1.6] text-ink-2">
      An agent that reads the web will sooner or later be told to do something it should not. Silo does not rely on the model refusing. Six layers stand between a misled agent and anything you would mind, and each one works without the others, so an attack has to get past all of them.
    </p>
  </section>

  <section id="layers" class="mx-auto mt-10 max-w-[1200px] px-5">
    <Security />
  </section>

  <section id="attacks" class="mx-auto mt-28 max-w-[1200px] px-5">
    <p class="text-[13px] font-medium text-ink-3">Followed through</p>
    <h2 class="mt-2 text-[30px] font-semibold leading-[1.15] tracking-[-0.02em]">Two attacks, layer by layer.</h2>
    <div class="mt-9 grid gap-3 lg:grid-cols-2">
      {
        attacks.map((a) => (
          <a href={a.href} class="press group flex flex-col rounded-panel bg-well p-5 hover:bg-pressed sm:p-6">
            <p class="text-[17px] font-semibold">{a.title}</p>
            <p class="mt-1.5 text-[14.5px] leading-[1.55] text-ink-2">{a.text}</p>
            <ol class="mt-5 grid gap-1.5">
              {a.steps.map(([n, t]) => (
                <li class="flex items-baseline gap-3 rounded-sm bg-surface px-3 py-2 text-[13.5px] shadow-card">
                  <span class="w-[52px] shrink-0 font-mono text-[11.5px] text-ink-3">Layer {n}</span>
                  <span>{t}</span>
                </li>
              ))}
            </ol>
            <p class="mt-5 text-[14px] font-medium text-cobalt group-hover:text-cobalt-deep">Read it step by step</p>
          </a>
        ))
      }
    </div>
  </section>

  <aside id="limits" class="mx-auto mt-20 max-w-[1200px] px-5" aria-labelledby="limits-head">
    <div class="max-w-[68ch] border-l-2 border-line-strong pl-5">
      <p id="limits-head" class="text-[14.5px] font-semibold">What the layers do not cover</p>
      <ul class="mt-3 grid gap-2 text-[14.5px] leading-[1.6] text-ink-2">
        {
          limits.map((l) => (
            <li>
              <span class="font-medium text-ink">{l.title}.</span> {l.text}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-[14.5px] leading-[1.6] text-ink-2">
        Each layer has edges of its own, which is why they work independently. For what to set around them, see{" "}
        <a href="/docs/concepts/rules/" class="font-medium text-cobalt hover:text-cobalt-deep">how rules decide</a>.
      </p>
    </div>
  </aside>
</Page>
