---
// The SiloOS section, told in pictures: the first-boot console beside what
// the OS hardens, then where it runs and how an update moves the machine. The console's
// lines are the ones SiloOS prints (images/os/README.md).
import mark from "../assets/mark.svg?raw";

const guards = [
  {
    title: "Nothing runs as root",
    text: "Silo, its database and every agent's machine run under one unprivileged user, on rootless Podman.",
    icon: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  },
  {
    title: "Immutable",
    text: "The system is a read-only image. Nothing installs onto it between updates.",
    icon: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  },
  {
    title: "No login to attack",
    text: "No user account and no password. The web console is the only way in.",
    icon: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>',
  },
  {
    title: "Patched in one piece",
    text: "The system and Silo arrive as one matched image, on the schedule you set.",
    icon: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  },
];

const hosts = ["QEMU / KVM", "VMware", "Hyper-V", "Incus", "Bare metal"];
const arches = ["AMD64", "ARM64"];

const track = [
  { word: "Previous", text: "Kept, to roll back to", kind: "kept" },
  { word: "Running", text: "What the machine booted", kind: "now" },
  { word: "Next", text: "Applied on a reboot you pick", kind: "next" },
];
---

<section id="siloos" class="mx-auto mt-28 max-w-[1200px] px-5">
  <p class="text-[13px] font-medium text-ink-3">The easy way to run it</p>
  <h2 class="mt-2 text-[30px] font-semibold leading-[1.15] tracking-[-0.02em]">SiloOS</h2>
  <p class="mt-4 max-w-[62ch] text-[16px] leading-[1.65] text-ink-2">
    An operating system that only runs Silo, locked down for that one job. Give it a VM or a machine and it boots into Silo with its database and HTTPS, managed from a page in Admin.
  </p>

  <div class="mt-9 grid items-stretch gap-3 lg:grid-cols-2">
    <figure class="flex flex-col justify-between gap-8 overflow-hidden rounded-panel bg-hatch p-5 text-on-hatch">
      <div class="flex items-center gap-3">
        <span class="block h-10 w-10 shrink-0 [&>svg]:h-full [&>svg]:w-full" set:html={mark} />
        <p>
          <span class="block text-[15px] font-semibold">SiloOS</span>
          <span class="flex items-center gap-1.5 font-mono text-[12px] text-on-hatch/60">
            <span class="h-[7px] w-[7px] rounded-full bg-lamp" aria-hidden="true"></span>
            running · first boot
          </span>
        </p>
      </div>
      <div>
        <figcaption class="font-mono text-[12px] text-on-hatch/60">the machine's screen</figcaption>
        <pre class="mt-2 overflow-x-auto font-mono text-[12.5px] leading-[1.8]"><code><span class="block">SiloOS  ·  <span class="text-lamp">https://192.168.1.20</span></span><span class="block text-on-hatch/70">First sign-in: admin@silo.local / k7mp-x3qa-9ten</span></code></pre>
      </div>
    </figure>

    <ul class="grid gap-x-5 gap-y-5 rounded-panel bg-well p-5 sm:grid-cols-2">
      {
        guards.map((g) => (
          <li class="flex gap-3">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-sm bg-surface text-ink-2 shadow-card">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={g.icon} />
            </span>
            <div>
              <p class="text-[14px] font-semibold">{g.title}</p>
              <p class="mt-0.5 text-[13px] leading-[1.5] text-ink-2">{g.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="rounded-panel bg-well p-5">
      <p class="text-[14px] font-semibold">Runs as a VM, or on a machine of its own</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        <ul class="contents" aria-label="Where it runs">
          {hosts.map((h) => <li class="rounded-control bg-surface px-2.5 py-1 font-mono text-[12px] shadow-card">{h}</li>)}
        </ul>
        <ul class="contents" aria-label="Processor architectures">
          {arches.map((a) => <li class="rounded-control bg-hatch px-2.5 py-1 font-mono text-[12px] text-on-hatch">{a}</li>)}
        </ul>
      </div>
    </div>

    <figure class="rounded-panel bg-well p-5">
      <figcaption class="text-[14px] font-semibold">An update replaces the whole image</figcaption>
      <ol class="siloos-track mt-4 grid gap-3 sm:grid-cols-3 sm:gap-0">
        {
          track.map((t) => (
            <li class="siloos-stop relative sm:pt-6" data-kind={t.kind}>
              <span class="siloos-dot" aria-hidden="true" />
              <p class="text-[13.5px] font-semibold">{t.word}</p>
              <p class="mt-0.5 pr-3 text-[12.5px] leading-[1.5] text-ink-2">{t.text}</p>
            </li>
          ))
        }
      </ol>
    </figure>
  </div>
</section>

<style is:global>
  /* The update track: three stops on one line, the running one lit. */
  .siloos-dot {
    display: none;
  }
  @media (min-width: 640px) {
    .siloos-stop::before {
      content: "";
      position: absolute;
      top: 6px;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--color-line-strong);
    }
    .siloos-stop[data-kind="next"]::before {
      background: repeating-linear-gradient(to right, var(--color-line-strong) 0 5px, transparent 5px 10px);
    }
    .siloos-dot {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 13px;
      height: 13px;
      border-radius: 9999px;
      background: var(--color-well);
      box-shadow: inset 0 0 0 1.5px var(--color-ink-3);
    }
    .siloos-stop[data-kind="now"] .siloos-dot {
      background: var(--color-lamp);
      box-shadow: none;
    }
    .siloos-stop[data-kind="next"] .siloos-dot {
      box-shadow: inset 0 0 0 1.5px var(--color-cobalt);
    }
  }
</style>
