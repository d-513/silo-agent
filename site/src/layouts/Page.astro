---
import "../styles/site.css";
import mark from "../assets/mark.svg?raw";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const repo = "https://github.com/d-513/silo-agent";

// The site's pages, the same on every page; the logo is Home. The one you
// are on is lit. The landing is an overview read top to bottom and has no
// tabs of its own: a topic that grows into a page of its own (Security did)
// gets a link here.
const path = Astro.url.pathname.replace(/\/?$/, "/");
const links = [
  { label: "Security", href: "/security/" },
  { label: "Docs", href: "/docs/" },
].map((l) => ({ ...l, here: path.startsWith(l.href) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The theme before the first paint. The key is the docs' (Starlight's);
         silo.theme is the console's, which the demo in a frame reads. -->
    <script is:inline>
      (function () {
        var pick = null;
        try {
          pick = localStorage.getItem("starlight-theme");
        } catch (e) {}
        if (pick !== "light" && pick !== "dark") pick = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = pick;
      })();
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <!-- The header stays on screen, with a hairline once the page has
         moved. The page you are on carries a cobalt bar on the header's
         edge, as the console marks its open tab. -->
    <header data-site-header class="site-header sticky top-0 z-40 border-b border-transparent bg-canvas">
      <div class="mx-auto flex h-14 max-w-[1200px] items-center gap-2 px-5 sm:gap-6">
        <a href="/" class="flex shrink-0 items-center gap-2.5 text-[17px] font-semibold tracking-tight">
          <span class="block h-7 w-7 [&>svg]:h-full [&>svg]:w-full" set:html={mark} />
          <span class="hidden min-[400px]:inline">Silo</span>
        </a>
        <nav aria-label="Site" class="flex h-full items-stretch">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={l.here ? "page" : undefined}
              class="relative flex items-center px-3 text-[14px] font-medium text-ink-2 transition-colors after:absolute after:inset-x-3 after:-bottom-px after:h-[2px] after:rounded-full after:bg-cobalt after:opacity-0 hover:text-ink aria-[current=page]:text-ink aria-[current=page]:after:opacity-100"
            >
              {l.label}
            </a>
          ))}
        </nav>
        <div class="ml-auto flex items-center gap-1 text-[14px] text-ink-2">
          <a class="press hidden rounded-control px-3 py-1.5 hover:bg-well hover:text-ink sm:block" href={repo}>GitHub</a>
          <button type="button" data-theme-toggle class="press rounded-control px-3 py-1.5 hover:bg-well hover:text-ink" aria-label="Switch between light and dark">
            <span class="[[data-theme=dark]_&]:hidden">Dark</span>
            <span class="hidden [[data-theme=dark]_&]:inline">Light</span>
          </button>
          <a class="press ml-1 rounded-control bg-ink px-3 py-1.5 font-medium text-on-ink hover:bg-ink-deep" href="/docs/install/">Install</a>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="mx-auto mt-28 max-w-[1200px] px-5 pb-12">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line pt-6 text-[13px] text-ink-3">
        <span>Silo Agent</span>
        <a class="hover:text-ink" href="/security/">Security</a>
        <a class="hover:text-ink" href="/docs/">Docs</a>
        <a class="hover:text-ink" href="/docs/install/">Install</a>
        <a class="hover:text-ink" href={repo}>Source</a>
        <span class="ml-auto font-mono text-[12px]">Self-hosted. Your keys stay on your server.</span>
      </div>
    </footer>

    <script>
      // The hairline under the sticky header, once the page has moved.
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      const stuck = () => header?.toggleAttribute("data-stuck", scrollY > 4);
      addEventListener("scroll", stuck, { passive: true });
      stuck();

      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
          // The console's own key: the demo's frame hears the change and follows.
          localStorage.setItem("silo.theme", next);
        } catch {
          /* storage is blocked: the choice lasts for this page */
        }
      });
    </script>
  </body>
</html>
