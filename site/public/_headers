# Cloudflare Pages. Hashed files never change; the demo's page is the console
# in a frame, shown only by this site.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable
/demo/*
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex
