http_addr: ":8080"
data_dir: ./data
# Postgres + pgvector. `make db-up` runs this one (docker-compose.dev.yml).
database_url: postgres://silo:silo@localhost:5433/silo?sslmode=disable
docker_host: unix:///run/user/1000/podman/podman.sock
cp_url: http://host.containers.internal:8080
public_url: http://127.0.0.1:5173
bot_image: localhost/silo-bot:v1
mcp_stdio_image: localhost/silo-mcp-stdio:v1

# Model ids are provider/model. Providers: openrouter, openai, anthropic.
# The default model must be one of models below.
model: openrouter/openai/gpt-5.6-luna
# Chat title model. Leave empty to use the default model.
model_title: ""
# Auto-approval model. Decides rules set to "auto". Empty uses model_title.
model_approval: ""
# Operator allowlist: only these models appear in the chat model picker.
models:
  - openrouter/openai/gpt-5.6-luna

# Debug logging. When true, every model request/response is stored and shown
# on the Admin → Debug tab. Off by default. Env: SILO_DEBUG.
debug: false

# First admin only. Wipe data/ to recreate. Not OpenRouter.
bootstrap:
  email: admin@local
  password: change-me

# Keep connections Silo makes on a user's word (connector URLs, Email and
# Calendar accounts, skill downloads) off this machine and your network
# (docs/CONFIGURATION.md § Outbound connections).
# outbound:
#   block_private: true
#   allow: 127.0.0.1:9223        # internal addresses that stay reachable

# Sign-in (docs/CONFIGURATION.md § Sign-in). More people get an account from
# an invite link in Admin → Users.
# auth:
#   trusted_proxies: 127.0.0.1   # reverse proxies whose X-Forwarded-For is believed
#   host_cookie: true            # __Host- session cookie; for tunnels under the same domain as Silo (needs https public_url)
#   password: false              # OIDC only; ignored unless oidc is configured
# oidc:
#   issuer: https://id.example.com
#   client_id: silo
#   client_secret: ""
#   auto_create: false           # make accounts on first sign-in

# Model providers. Env wins: SILO_PROVIDERS__OPENROUTER__API_KEY,
# SILO_PROVIDERS__OPENAI__API_KEY, SILO_PROVIDERS__ANTHROPIC__API_KEY.
providers:
  openrouter:
    api_key: ""
    # base_url: ""          # optional
    # cache: false          # prompt caching is on; Claude is marked with cache_control
    # cache_ttl: 5m         # Claude cache lifetime: 5m or 1h
  openai:
    api_key: ""
    # base_url: ""          # optional proxy/self-hosted override
    # cache: false          # on by default: sends prompt_cache_key for routing
  anthropic:
    api_key: ""
    # cache: false          # on by default: cache_control breakpoints
    # cache_ttl: 5m         # 5m or 1h
  # Fast and live pieces of a voice call (each: api_key, optional base_url):
  # groq: { api_key: "" }        # a talker (model_voice) with a short time to the first word; Whisper
  # cerebras: { api_key: "" }    # a talker
  # deepgram: { api_key: "" }    # live Nova-3 / Flux transcription, Aura voices
  # elevenlabs: { api_key: "" }  # live Flash voices (Polish too), Scribe transcription
  # cartesia: { api_key: "" }    # live Sonic voices, Ink transcription
  # inworld: { api_key: "" }     # live TTS 2 voices (the Base64 key from the Portal)
  # soniox: { api_key: "" }      # live transcription, strong Polish
  # assemblyai: { api_key: "" }  # live Universal Streaming transcription
  # local:
  #   base_url: http://localai:8080/v1
  #   realtime: openai          # transcribes live over the Realtime API (speaches for Speaches)

# Voice: Read aloud and calls (Admin → Settings → Voice). A model marked Live
# streams; any other is asked one request at a time.
# model_voice: groq/openai/gpt-oss-120b      # the talker; empty: the Bot answers every turn
# voice:
#   speech_model: elevenlabs/eleven_flash_v2_5
#   transcribe_model: deepgram/flux-general-en   # calls; dictation stays on transcribe_model
#   webrtc:
#     udp_port: 3479        # publish beside the HTTP port
#     public_ips: []        # the control plane's public address behind NAT

# Content host & tunnels: Bot-made content is served by this control plane on a
# domain separate from the console's — tunnels at tunnel-<name>.<host>, live app
# artifacts at app-<name>.<host>, and public shared links at share-<name>.<host>.
# Needs wildcard DNS + TLS for *.<host>. With a local public_url (as above) the
# host defaults to localhost:<http_addr port>, so nothing is needed in
# development. Env: SILO_CONTENT__HOST, SILO_CONTENT__SCHEME, SILO_TUNNELS__ENABLED
# content:
#   host: content.example.com
#   scheme: https           # default: follows public_url
# tunnels:
#   enabled: true

# Mail: every Bot gets a receive-only address <name>@<domain>, served by an
# SMTP listener in this control plane. Point the domain's MX record here and
# get port 25 to `addr`. Nothing is ever sent. In development any domain works
# (nothing is looked up to receive): try it with
#   swaks --server localhost:2525 --to <name>@silo.localhost
# Env: SILO_MAIL__DOMAIN, SILO_MAIL__ADDR, SILO_MAIL__ENABLED, SILO_MAIL__MAX_SIZE_MB
# mail:
#   domain: bots.example.com
#   addr: ":2525"
#   enabled: true
#   max_size_mb: 10

# Web search engine. Env: SILO_SEARCH__ENGINE
# builtin is the Built-in Scraper: a keyless metasearch over DuckDuckGo, Mojeek,
# Brave, Startpage, Wikipedia and Marginalia. `sources` narrows that list.
search:
  engine: builtin
  # builtin:
  #   sources: duckduckgo,brave,wikipedia

# Operator-defined connector variables. Connectors reference these as ${NAME}
# in their URL, headers, OAuth fields, STDIO command/args/image, env values,
# and prompt. Env: SILO_CONNECTOR_VARS__NAME (keys are lowercased).
#
# These are plain variables, NOT secrets: they live in silo.yaml in clear text
# and are not protected. Use a Bot Secret for credentials.
# connector_vars:
#   TENANT: acme
#   MCP_HOST: mcp.internal.example.com
#   LIGHTPANDA_URL: http://localhost:9223   # Lightpanda preset (make db-up)

# Library connectors every new Bot gets, by identifier (the Identifier field of
# a preset in Admin → Connectors; fal.ai is fal_ai). This adds to the presets
# whose own "Add to new bots by default" is on. Case does not matter; an
# identifier with no library connector is skipped.
# Env: SILO_AUTOENABLE_CONNECTORS=lightpanda,fal_ai
# autoenable_connectors:
#   - lightpanda
#   - fal_ai
